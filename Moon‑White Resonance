function loadMore(){if(loadingMore||!hasMore)return;loadingMore=true;currentPage++;fetchPage(keyword,currentPage,false)}
function fetchPage(kw,p,isNew){var l=$('searchList');if(isNew)l.innerHTML='<div class="loading">🔍 搜索中...</div>';fetch(API.search+'?key='+encodeURIComponent(kw)+'&pn='+p+'&rn=20').then(function(r){return r.json()}).then(function(d){var nr=[];if(d&&d.data&&d.data.list)nr=d.data.list;else if(Array.isArray(d))nr=d;nr=nr.map(function(i){return{rid:i.rid||i.id,name:i.name||i.songname,artist:i.artist||i.singer,pic:i.pic||i.pic120||'https://img1.kuwo.cn/star/albumcover/120/default.jpg'}}).filter(function(i){return i.rid});hasMore=nr.length>=20;searchResults=isNew?nr:searchResults.concat(nr);renderSearch();loadingMore=false}).catch(function(e){if(isNew)l.innerHTML='<div class="empty"><div class="empty-icon">⚠️</div><div>搜索失败</div></div>';loadingMore=false})}
function renderSearch(){var l=$('searchList');if(!searchResults.length){l.innerHTML='<div class="empty"><div class="empty-icon">😕</div><div>未找到歌曲</div></div>';return}var li=isLoggedIn();var h='<div id="ssl">';searchResults.forEach(function(s,i){var f=isFav(s.rid);h+='<div class="song-item" data-i="'+i+'"><img class="song-cover" src="'+s.pic+'" alt=""><div class="song-info"><div class="song-name">'+esc(s.name)+'</div><div class="song-artist">'+esc(s.artist)+'</div></div><div class="song-actions"><button class="btn-fav '+(f?'faved':'')+'" data-a="f">'+(f?'❤️':'🤍')+'</button><button class="btn-add-pl '+(li?'':'locked')+'" data-a="a">➕</button><button class="btn-play" data-a="p">▶️</button></div></div>'});h+='</div>';if(hasMore)h+='<button class="load-more-btn" onclick="loadMore()">📥 加载更多</button>';l.innerHTML=h;l.querySelectorAll('#ssl .song-item').forEach(function(it){var i=parseInt(it.dataset.i);it.onclick=function(e){var a=e.target.dataset.a;if(a==='f')tfs(i);else if(a==='a')showAddToPlaylist(searchResults[i]);else playAt(i)}})}
function playAt(i){if(checkCurrentUserBanned())return;playlist=searchResults.slice();playIndex=i;playSong(playlist[i])}
function tfs(i){var s=searchResults[i];var fs=getFav(),fi=fs.findIndex(function(x){return x.rid===s.rid});if(fi>=0){fs.splice(fi,1);toast('💔')}else{fs.unshift(s);toast('❤️')}saveFav(fs);renderSearch()}
function getFav(){try{return JSON.parse(localStorage.getItem(KEY.fav)||'[]')}catch(e){return[]}}
function saveFav(l){localStorage.setItem(KEY.fav,JSON.stringify(l));refreshBadges()}
function isFav(rid){return getFav().some(function(s){return s.rid===rid})}
function renderFav(){var l=$('favList'),fs=getFav();if(!fs.length){l.innerHTML='<div class="empty"><div class="empty-icon">🎶</div><div>还没有收藏</div></div>';return}var li=isLoggedIn();var h='<div id="fsl">';fs.forEach(function(s,i){h+='<div class="song-item" data-i="'+i+'"><img class="song-cover" src="'+s.pic+'" alt=""><div class="song-info"><div class="song-name">'+esc(s.name)+'</div><div class="song-artist">'+esc(s.artist)+'</div></div><div class="song-actions"><button class="btn-fav faved" data-a="f">❤️</button><button class="btn-add-pl '+(li?'':'locked')+'" data-a="a">➕</button><button class="btn-play" data-a="p">▶️</button></div></div>'});h+='</div>';l.innerHTML=h;l.querySelectorAll('#fsl .song-item').forEach(function(it){var i=parseInt(it.dataset.i);it.onclick=function(e){var a=e.target.dataset.a,fs=getFav();if(a==='f'){fs.splice(i,1);saveFav(fs);renderFav()}else if(a==='a')showAddToPlaylist(fs[i]);else{playlist=fs.slice();playIndex=i;playSong(playlist[i])}}})}
function getHistory(){try{return JSON.parse(localStorage.getItem(KEY.history)||'[]')}catch(e){return[]}}
function saveHistory(l){localStorage.setItem(KEY.history,JSON.stringify(l.slice(0,100)));refreshBadges()}
function addHistory(s){var h=getHistory().filter(function(x){return x.rid!==s.rid});h.unshift(s);saveHistory(h);renderHistory()}
function clearAllHistory(){if(!getHistory().length)return toast('历史为空');showDelConfirm('确定清空所有历史？',function(){localStorage.removeItem(KEY.history);refreshBadges();renderHistory();toast('🗑️ 已清空')})}
function renderHistory(){var l=$('historyList'),h=getHistory();if(!h.length){l.innerHTML='<div class="empty"><div class="empty-icon">🕐</div><div>还没有记录</div></div>';return}var li=isLoggedIn();var ht='<div id="hsl">';h.forEach(function(s,i){var f=isFav(s.rid);ht+='<div class="song-item" data-i="'+i+'"><img class="song-cover" src="'+s.pic+'" alt=""><div class="song-info"><div class="song-name">'+esc(s.name)+'</div><div class="song-artist">'+esc(s.artist)+'</div></div><div class="song-actions"><button class="btn-fav '+(f?'faved':'')+'" data-a="f">'+(f?'❤️':'🤍')+'</button><button class="btn-add-pl '+(li?'':'locked')+'" data-a="a">➕</button><button class="btn-del" data-a="d">🗑️</button><button class="btn-play" data-a="p">▶️</button></div></div>'});ht+='</div><button class="history-clear-btn" onclick="clearAllHistory()">🗑️ 清空全部</button>';l.innerHTML=ht;l.querySelectorAll('#hsl .song-item').forEach(function(it){var i=parseInt(it.dataset.i);it.onclick=function(e){var a=e.target.dataset.a,h=getHistory();if(a==='f'){var s=h[i],fs=getFav(),fi=fs.findIndex(function(x){return x.rid===s.rid});if(fi>=0)fs.splice(fi,1);else fs.unshift(s);saveFav(fs);renderHistory()}else if(a==='a')showAddToPlaylist(h[i]);else if(a==='d'){var n=h[i].name;showDelConfirm('删除「'+n+'」？',function(){h.splice(i,1);saveHistory(h);renderHistory()})}else{playlist=h.slice();playIndex=i;playSong(playlist[i])}}})}
function getSearchHis(){try{return JSON.parse(localStorage.getItem(KEY.searchHis)||'[]')}catch(e){return[]}}
function saveSearchHis(l){localStorage.setItem(KEY.searchHis,JSON.stringify(l.slice(0,20)));renderSearchHis()}
function addSearchHis(kw){if(!kw)return;var h=getSearchHis().filter(function(k){return k!==kw.trim()});h.unshift(kw.trim());saveSearchHis(h);searchHisManualHide=false;$('searchHistory').classList.remove('manually-hide');$('searchHisToggle').textContent='收起 ▲'}
function rsho(kw){saveSearchHis(getSearchHis().filter(function(k){return k!==kw}))}
function clearSearchHisAll(){if(!getSearchHis().length)return toast('历史为空');showDelConfirm('清空所有搜索历史？',function(){localStorage.removeItem(KEY.searchHis);renderSearchHis();toast('已清空')})}
function renderSearchHis(){var c=$('historyTags'),h=getSearchHis(),el=$('searchHistory');if(!h.length){el.style.display='none';return}el.style.display='block';c.innerHTML=h.map(function(kw){return'<span class="search-history-tag" data-kw="'+esc(kw)+'"><span class="kwt">'+esc(kw)+'</span><span class="del">✕</span></span>'}).join('');c.querySelectorAll('.search-history-tag').forEach(function(t){t.querySelector('.kwt').onclick=function(){$('searchInput').value=t.dataset.kw;doSearch()};t.querySelector('.del').onclick=function(e){e.stopPropagation();rsho(t.dataset.kw)}})}
function saveLast(s,ct,d){localStorage.setItem(KEY.last,JSON.stringify({song:s,currentTime:ct||0,duration:d||0,time:Date.now()}));renderLast()}
function getLast(){try{return JSON.parse(localStorage.getItem(KEY.last)||'null')}catch(e){return null}}
function renderLast(){var d=getLast();if(!d||!d.song){$('lastPlayed').style.display='none';return}$('lastPlayed').style.display='flex';$('lastName').textContent=d.song.name;$('lastArtist').textContent=d.song.artist;$('lastProgress').style.width=Math.min(d.duration>0?(d.currentTime/d.duration*100):0,100)+'%'}
function resumeLast(){if(checkCurrentUserBanned())return;var d=getLast();if(!d||!d.song)return;playlist=[d.song];playIndex=0;playSong(d.song,d.currentTime)}
function switchTab(t){curTab=t;document.querySelectorAll('.tab').forEach(function(x){x.classList.remove('active')});document.querySelectorAll('.song-list').forEach(function(x){x.classList.remove('active')});$('tab-'+t).classList.add('active');$(t+'List').classList.add('active');refreshBadges();if(t==='fav')renderFav();if(t==='history')renderHistory()}
function loadSpeed(){var s=parseFloat(localStorage.getItem(KEY.speed));if(s&&s>=0.5&&s<=2.0)speed=s;updateSpeedUI()}
function updateSpeedUI(){$('speedBtn').textContent=speed.toFixed(1)+'x';$('settingSpeedBtn').innerHTML=speed.toFixed(1)+'x <span class="setting-arrow">›</span>';document.querySelectorAll('#speedMask .option-btn').forEach(function(b){b.classList.toggle('active',parseFloat(b.textContent)===speed)})}
function setSpeed(s){if(s<0.5)s=0.5;if(s>2.0)s=2.0;speed=s;if(audio)audio.playbackRate=s;localStorage.setItem(KEY.speed,s.toString());updateSpeedUI();closeModal('speedMask');toast('⏱️ 倍速:'+s.toFixed(1)+'x')}
function isMeta(t){if(!t)return true;var x=t.trim().toLowerCase(),k=['作词','作曲','编曲','制作人','op:','sp:','publisher','label','歌手','专辑'];for(var i=0;i<k.length;i++)if(x.indexOf(k[i])>=0)return true;return false}
function needT(t){return t&&(/[a-zA-Z]{2,}/.test(t)||/[ぁ-ゖァ-ヺ]/.test(t)||/[가-힣]/.test(t))}
function toggleTranslate(){transOn=!transOn;$('translateSwitch').checked=transOn;$('translateBtn').classList.toggle('active',transOn);localStorage.setItem(KEY.trans,JSON.stringify(transOn));if(transOn){toast('🌐 翻译已开');if(currentSong&&lyrics.length){transAbort=false;startTranslate()}}else{transAbort=true;translating=false;renderLyrics(lyrics);renderFullLyrics()}}
function clearTransCache(){transCache={};localStorage.removeItem(KEY.transCache);if(lyrics.length){lyrics.forEach(function(l){l.trans=''});renderLyrics(lyrics);renderFullLyrics()}toast('🧹 已清空')}
function tl(text,idx,rid,tar){if(currentTranslatingRid!==rid)return Promise.resolve();return fetch(API_ZHIPU,{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+API_ZHIPU_KEY},body:JSON.stringify({model:'glm-4-flash',messages:[{role:'user',content:'只输出中文翻译:'+text}],temperature:.3,max_tokens:256})}).then(function(r){if(currentTranslatingRid!==rid)return;return r.json()}).then(function(d){if(currentTranslatingRid!==rid)return;if(d&&d.choices&&d.choices[0]){var tr=d.choices[0].message.content.trim().replace(/^["']|["']$/g,'');if(tr&&tr!==text)tar[idx].trans=tr}}).catch(function(){})}
function startTranslate(){if(!lyrics.length||translating)return;var ck=currentSong?currentSong.rid:'?';if(transCache[ck]&&transCache[ck].lines&&transCache[ck].lines.length===lyrics.length){lyrics.forEach(function(l,i){l.trans=transCache[ck].lines[i]||''});renderLyrics(lyrics);renderFullLyrics();return}currentTranslatingRid=ck;translating=true;toast('🌐 翻译中...');var ts=[];lyrics.forEach(function(l,i){if(l.lineLyric&&!isMeta(l.lineLyric)&&needT(l.lineLyric))ts.push({t:l.lineLyric,i:i})});if(!ts.length){translating=false;return}var n=0;function nb(){if(n>=ts.length){if(currentSong&&currentSong.rid===ck){transCache[ck]={lines:lyrics.map(function(l){return l.trans||''})};try{localStorage.setItem(KEY.transCache,JSON.stringify(transCache))}catch(e){}renderLyrics(lyrics);renderFullLyrics();toast('✅ 翻译完成')}translating=false;return}var b=ts.slice(n,n+3);Promise.all(b.map(function(x){return tl(x.t,x.i,ck,lyrics).then(function(){if(currentSong&&currentSong.rid===ck){renderLyrics(lyrics);renderFullLyrics()}})})).then(function(){n+=3;nb()})}nb()}
function renderLyrics(list){var c=$('lyricsContainer');if(!list||!list.length){c.innerHTML='<div class="lyric-line">暂无歌词</div>';return}var html='';for(var i=0;i<list.length;i++){var l=list[i],tr=transOn&&l.trans?l.trans:'';html+='<div class="lyric-line" data-i="'+i+'" data-t="'+parseFloat(l.time||0).toFixed(3)+'"><span class="lyric-original">'+esc(l.lineLyric||'')+'</span>';if(tr)html+='<span class="lyric-translation">'+esc(tr)+'</span>';html+='</div>'}c.innerHTML=html;lyricIndex=-1}
function renderFullLyrics(){var c=$('fullLyricsBody');if(!c)return;if(!fullLyrics||!fullLyrics.length){c.innerHTML='<div class="full-lyric">暂无歌词</div>';return}var html='';for(var i=0;i<fullLyrics.length;i++){var l=fullLyrics[i],tr=transOn&&l.trans?l.trans:'';html+='<div class="full-lyric" data-i="'+i+'" data-t="'+parseFloat(l.time||0).toFixed(3)+'"><span class="full-lyric-orig">'+esc(l.lineLyric||'')+'</span>';if(tr)html+='<span class="full-lyric-trans">'+esc(tr)+'</span>';html+='</div>'}c.innerHTML=html;var els=c.querySelectorAll('.full-lyric');for(var j=0;j<els.length;j++){els[j].onclick=function(){var t=parseFloat(this.dataset.t||0);if(audio)audio.currentTime=t;closeFullLyrics()}}}
function toggleLoop(){loopMode=(loopMode+1)%3;var b=$('btnLoop');b.classList.toggle('active',loopMode!==LOOP.none);b.textContent=loopMode===LOOP.one?'🔂':'🔁';toast(loopMode===LOOP.one?'单曲循环':loopMode===LOOP.all?'列表循环':'关闭循环')}
function toggleShuffle(){shuffle=!shuffle;$('btnShuffle').classList.toggle('active',shuffle);toast(shuffle?'🎲 随机':'顺序')}
function openFullLyrics(){renderFullLyrics();$('lyricsMask').classList.add('show');setTimeout(scrollFullToCurrent,150)}
function closeFullLyrics(){$('lyricsMask').classList.remove('show')}
function scrollFullToCurrent(){if(lyricIndex<0||lyricIndex>=fullLyrics.length)return;var ls=document.querySelectorAll('.full-lyric');if(!ls[lyricIndex])return;for(var i=0;i<ls.length;i++)ls[i].classList.remove('active');ls[lyricIndex].classList.add('active');ls[lyricIndex].scrollIntoView({block:'center',behavior:'smooth'})}
/* 播放前检查封禁 */
function playSong(song,rt){if(checkCurrentUserBanned())return;transAbort=true;translating=false;currentTranslatingRid=null;currentSong=song;lyricIndex=-1;lyrics=[];fullLyrics=[];renderLyrics([]);renderFullLyrics();$('playerBar').classList.add('show');updateFooterBar();$('miniName').textContent=song.name;$('miniArtist').textContent=song.artist;$('miniCover').src=song.pic;$('pageTitle').textContent=song.name;$('pageCover').src=song.pic;$('playerPage').classList.add('show');addHistory(song);loadLyrics(song.rid);fetch(API.url+'?mid='+song.rid+'&type=music&br=128kmp3').then(function(r){return r.json()}).then(function(d){if(d&&d.data&&d.data.url){audio.src=d.data.url;audio.playbackRate=speed;audio.play().then(function(){isPlaying=true;updatePlayBtn();if(rt)setTimeout(function(){audio.currentTime=rt},300)})}else toast('获取地址失败')}).catch(function(){toast('网络错误')})}
function loadLyrics(rid){fetch(API.lrc+'?musicId='+rid).then(function(r){return r.json()}).then(function(d){lyrics=(d&&d.data&&d.data.lrclist)?d.data.lrclist:[];lyrics=lyrics.map(function(l){return{time:l.time,lineLyric:l.lineLyric,trans:''}});fullLyrics=lyrics.slice();renderLyrics(lyrics);renderFullLyrics();if(transOn&&lyrics.length){transAbort=false;setTimeout(startTranslate,300)}}).catch(function(){lyrics=[];fullLyrics=[];renderLyrics([]);renderFullLyrics()})}
function updateLyric(ct){if(!lyrics||!lyrics.length)return;var f=-1;for(var i=0;i<lyrics.length;i++){var t=parseFloat(lyrics[i].time||0);if(t<=ct)f=i;else break}if(f===lyricIndex||f<0)return;lyricIndex=f;var ls=document.querySelectorAll('.lyric-line');for(var j=0;j<ls.length;j++)ls[j].classList.remove('active');if(ls[f]){ls[f].classList.add('active');var sec=document.querySelector('.lyrics-section'),lh=ls[f].offsetHeight||36;$('lyricsContainer').style.transform='translateY('+(-(f*lh)+(sec.clientHeight/2-lh/2))+'px)'}if($('lyricsMask').classList.contains('show'))scrollFullToCurrent()}
function togglePlay(){if(checkCurrentUserBanned())return;if(!audio.src){toast('请先选择歌曲');return}if(audio.paused)audio.play().then(function(){isPlaying=true;updatePlayBtn()});else{audio.pause();isPlaying=false;updatePlayBtn()}}
function updatePlayBtn(){var ic=isPlaying?'⏸️':'▶️';$('playBtn').textContent=ic;$('miniPlayBtn').textContent=ic;$('coverDisc').classList.toggle('playing',isPlaying)}
function openPlayer(){if(!currentSong){toast('请先播放歌曲');return}$('playerPage').classList.add('show')}
function closePlayer(){$('playerPage').classList.remove('show')}
function nextSong(){if(checkCurrentUserBanned())return;if(!playlist.length)return;playIndex=(playIndex+1)%playlist.length;playSong(playlist[playIndex])}
function prevSong(){if(checkCurrentUserBanned())return;if(!playlist.length)return;if(audio.currentTime>3){audio.currentTime=0;return}playIndex=(playIndex-1+playlist.length)%playlist.length;playSong(playlist[playIndex])}
function setTimer(m){if(sleepTimer)clearTimeout(sleepTimer);closeModal('timerMask');if(m===0)return toast('定时已关');sleepTimer=setTimeout(function(){audio.pause();isPlaying=false;updatePlayBtn();toast('⏰ 定时结束')},m*60*1000);toast('⏰ '+m+'分钟后暂停')}
function setupScroll(){var el=$('searchHistory');window.addEventListener('scroll',function(){if(el.style.display==='none'||searchHisManualHide)return;var y=window.scrollY||0;if(y>80)el.classList.add('scroll-hide');else if(y<50)el.classList.remove('scroll-hide')},{passive:true})}
function setupProgress(){var b=$('progressBar');b.onclick=function(e){if(!audio.duration)return;var r=b.getBoundingClientRect();audio.currentTime=Math.max(0,Math.min(1,(e.clientX-r.left)/r.width))*audio.duration}}
function setupAudio(){audio.addEventListener('play',function(){isPlaying=true;updatePlayBtn()});audio.addEventListener('pause',function(){isPlaying=false;updatePlayBtn();if(currentSong)saveLast(currentSong,audio.currentTime,audio.duration)});audio.addEventListener('timeupdate',function(){if(!audio.duration)return;$('curTime').textContent=fmt(audio.currentTime);$('totalTime').textContent=fmt(audio.duration);$('progressFill').style.width=(audio.currentTime/audio.duration*100)+'%';updateLyric(audio.currentTime)});audio.addEventListener('ended',function(){if(loopMode===LOOP.one){audio.currentTime=0;audio.play()}else nextSong()});audio.addEventListener('error',function(){toast('⚠️ 加载失败，自动下一首');setTimeout(nextSong,500)})}
function setupVolume(){var s=$('volumeSlider'),v=$('volumeVal');var sv=parseInt(localStorage.getItem(KEY.volume)||'80');s.value=sv;audio.volume=sv/100;v.textContent=sv+'%';s.oninput=function(){var val=parseInt(this.value);audio.volume=val/100;v.textContent=val+'%';localStorage.setItem(KEY.volume,val.toString())}}
function init(){refreshBadges();refreshUser();loadSpeed();renderSearchHis();renderLast();updatePlayBtn();setupAudio();setupProgress();setupScroll();setupVolume();updateFooterBar();checkCurrentUserBanned();$('translateSwitch').checked=transOn;$('translateBtn').classList.toggle('active',transOn);renderLyrics([]);renderFullLyrics()}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
</script>
