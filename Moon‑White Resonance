      <div class="form-group"><label>🤖 图形验证码（点击刷新）</label><div class="captcha-row"><input type="text" id="forgetCaptcha" placeholder="输入右侧验证码" maxlength="4"><div class="captcha-box" id="forgetCaptchaBox" onclick="genForgetCaptcha()">----</div></div></div>
