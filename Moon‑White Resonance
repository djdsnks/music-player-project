      <div class="form-group"><label>💼 密保问题2：你平时是做什么工作的？</label><select id="forgetJob"><option value="">请选择你的职业</option><option value="无业游民">无业游民</option><option value="医疗">医疗</option><option value="新闻报告">新闻报告</option><option value="员工">员工</option><option value="经济">经济</option><option value="股票">股票</option><option value="代码">代码</option></select></div>
