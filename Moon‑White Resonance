function checkRegFrequency(){var count=getRegLog().length;if(count>=4){var remain=3600-Math.floor((Date.now()-getRegLog()[0])/60000);return{blocked:true,msg:'⚠️ 风控提示：检测到短时间内频繁注册（'+count+'次），已触发平台风控系统。近1小时内注册的全部邮箱将被永久封禁，禁止登录、禁止注册、禁止播放全部音乐。请'+remain+'分钟后再试，或联系1226356177@qq.com申诉。'};}return{blocked:false,count:count}}
