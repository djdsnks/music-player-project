function doRegister(){var freq=checkRegFrequency();if(freq.blocked){/* 触发频繁注册，全部永久封禁 */var bannedList=banRecentRegisteredEmails();showRiskWarning('registerRiskWarning',freq.msg);toast('🚫 已永久封禁'+bannedList.length+'个邮箱');return}var e=$('registerEmail').value.trim().toLowerCase(),p=$('registerPassword').value,secret=$('registerSecret').value.trim(),job=$('registerJob').value,x=$('svipDate').value;var cap=$('registerCaptcha').value.trim().toUpperCase();if(!e||!validEmail(e))return toast('请输入有效邮箱');if(isTempEmail(e)){banEmail(e);showRiskWarning('registerRiskWarning','⚠️ 风控提示：检测到虚拟/临时邮箱，根据《自律守则》第七条，该邮箱已被永久封禁，禁止登录、禁止注册、禁止播放全部音乐。请使用真实个人邮箱。');return}if(isEmailBanned(e)){showRiskWarning('registerRiskWarning','⚠️ 风控提示：该邮箱已被永久封禁，禁止注册。如有异议请联系1226356177@qq.com申诉。');return}if(!p||p.length<6)return toast('密码至少6位');if(!secret)return toast('请填写密保问题1答案');if(!job)return toast('请选择你的职业');if(!cap)return toast('请输入图形验证码');if(cap!==registerCaptchaCode){toast('验证码错误');genRegisterCaptcha();return}if(!$('agreeRules').checked)return toast('请先阅读并同意《自律守则》');var us=getUsers();if(us.some(function(u){return u.email===e}))return toast('该邮箱已注册');us.push({email:e,password:p,secret:secret,job:job,svipExpiry:x,regTime:Date.now()});saveUsers(us);addRegLog();localStorage.setItem(KEY.current,JSON.stringify({email:e,svipExpiry:x}));toast('✅ 注册成功');refreshUser();closeAuth();if(pendingAddSong){var s=pendingAddSong;pendingAddSong=null;showAddToPlaylist(s)}}
function doLogin(){var e=$('loginEmail').value.trim().toLowerCase(),p=$('loginPassword').value;var cap=$('loginCaptcha').value.trim().toUpperCase();if(!e||!p)return toast('请填写完整');if(!cap)return toast('请输入图形验证码');if(cap!==loginCaptchaCode){toast('验证码错误');genLoginCaptcha();return}if(isEmailBanned(e)){showRiskWarning('loginRiskWarning','⚠️ 风控提示：该邮箱已被永久封禁，禁止登录。如有异议请联系1226356177@qq.com申诉。');showBanMask(e);return}var u=getUsers().find(function(x){return x.email===e&&x.password===p});if(!u){toast('邮箱或密码错误');genLoginCaptcha();return}if(!u.secret||!u.job){pendingLoginUser=u;toast('🔐 请先补填双重密保');switchAuthTab('fillSecret');return}localStorage.setItem(KEY.current,JSON.stringify({email:u.email,svipExpiry:u.svipExpiry}));toast('👋 欢迎回来');refreshUser();closeAuth();if(pendingAddSong){var s=pendingAddSong;pendingAddSong=null;showAddToPlaylist(s)}}
function doFillSecret(){var secret=$('fillSecretInput').value.trim(),job=$('fillJobInput').value;if(!secret)return toast('请填写密保问题1答案');if(!job)return toast('请选择你的职业');if(!pendingLoginUser)return;var us=getUsers(),i=us.findIndex(function(u){return u.email===pendingLoginUser.email});if(i>=0){us[i].secret=secret;us[i].job=job;saveUsers(us)}localStorage.setItem(KEY.current,JSON.stringify({email:pendingLoginUser.email,svipExpiry:pendingLoginUser.svipExpiry}));pendingLoginUser=null;toast('✅ 密保设置成功，已登录');refreshUser();closeAuth();if(pendingAddSong){var s=pendingAddSong;pendingAddSong=null;showAddToPlaylist(s)}}
