/* 触发频繁注册时，把近1小时内注册的所有邮箱全部永久封禁 */
function banRecentRegisteredEmails(){var us=getUsers();var now=Date.now();var banned=[];us.forEach(function(u){if(u.regTime&&(now-u.regTime)<3600000){banEmail(u.email);banned.push(u.email)}});return banned}
